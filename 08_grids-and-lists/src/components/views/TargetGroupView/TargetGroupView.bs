sub init()
    m.scrollContainer = m.top.findNode("scrollContainer")
    m.scrollAnim = m.top.findNode("scrollAnim")
    m.scrollInterp = m.top.findNode("scrollInterp")
    m.focusLabel = m.top.findNode("focusLabel")

    m.currentRowIndex = 0
    m.gapX = 15
    m.rowSpacing = 550
    m.containerX = 500
    m.baseContainerY = 400

    ' Row definitions — add/remove rows here, everything else adapts
    m.rowDefs = [
        { title: "Live", focusedW: 712, focusedH: 448, unfocusedW: 564, unfocusedH: 375, visibleCols: 3, itemCount: 15 },
        { title: "Top 10", focusedW: 777, focusedH: 478, unfocusedW: 348, unfocusedH: 478, visibleCols: 4, itemCount: 15 },
        { title: "Originals", focusedW: 321, focusedH: 439, unfocusedW: 258, unfocusedH: 378, visibleCols: 5, itemCount: 15 }
    ]

    m.targetGroups = []
    m.focusedTargetSets = []
    m.unfocusedTargetSets = []
    m.itemIndices = []
    m.rowPositions = []

    buildRows()
    updateLabels()

    m.top.observeField("focusedChild", "onFocusedChildChanged")
end sub

sub buildRows()
    colors = Constants.Palette.GetItemColors()
    yPos = 0

    for i = 0 to m.rowDefs.count() - 1
        rowDef = m.rowDefs[i]

        ' Create row title label
        rowLabel = createObject("roSGNode", "Label")
        rowLabel.text = rowDef.title
        rowLabel.translation = [-450, yPos - 20]
        rowLabel.font = createObject("roSGNode", "Font")
        rowLabel.font.size = 28
        rowLabel.color = "#888888"
        m.scrollContainer.appendChild(rowLabel)

        ' Create TargetGroup node
        tg = createObject("roSGNode", "TargetGroup")
        tg.translation = [0, yPos]
        tg.itemComponentName = "TargetGroupItem"

        ' Create TargetSets
        focusedTS = createFocusedTargetSet(rowDef)
        unfocusedTS = createUnfocusedTargetSet(rowDef)

        if i = 0
            tg.targetSet = focusedTS
        else
            tg.targetSet = unfocusedTS
        end if

        ' Create content
        contentRoot = createObject("roSGNode", "ContentNode")
        for j = 0 to rowDef.itemCount - 1
            child = contentRoot.createChild("ContentNode")
            child.title = rowDef.title + " " + j.toStr()
            child.addFields({ itemColor: colors[j mod colors.count()] })
        end for
        tg.content = contentRoot

        m.scrollContainer.appendChild(tg)

        ' Track state
        m.targetGroups.push(tg)
        m.focusedTargetSets.push(focusedTS)
        m.unfocusedTargetSets.push(unfocusedTS)
        m.itemIndices.push(0)
        m.rowPositions.push(yPos)

        yPos = yPos + m.rowSpacing
    end for
end sub

sub onFocusedChildChanged()
    if m.top.hasFocus()
        m.targetGroups[m.currentRowIndex].setFocus(true)
    end if
end sub

function createFocusedTargetSet(rowDef as object) as object
    targetSet = createObject("roSGNode", "TargetSet")

    rects = []
    startX = -350

    ' Position 0: Focused item
    rects.push({ x: startX, y: -rowDef.focusedH / 2, width: rowDef.focusedW, height: rowDef.focusedH })

    ' Positions 1+: Unfocused items
    x = startX + rowDef.focusedW + m.gapX
    for i = 1 to rowDef.visibleCols - 1
        rects.push({ x: x, y: -rowDef.unfocusedH / 2, width: rowDef.unfocusedW, height: rowDef.unfocusedH })
        x = x + rowDef.unfocusedW + m.gapX
    end for

    targetSet.targetRects = rects
    targetSet.focusIndex = 0

    return targetSet
end function

function createUnfocusedTargetSet(rowDef as object) as object
    targetSet = createObject("roSGNode", "TargetSet")

    rects = []
    startX = -250
    x = startX

    for i = 0 to rowDef.visibleCols - 1
        rects.push({ x: x, y: -rowDef.unfocusedH / 2, width: rowDef.unfocusedW, height: rowDef.unfocusedH })
        x = x + rowDef.unfocusedW + m.gapX
    end for

    targetSet.targetRects = rects
    targetSet.focusIndex = 0

    return targetSet
end function

sub scrollToRow(newIndex as integer)
    if newIndex = m.currentRowIndex then return
    if newIndex < 0 or newIndex >= m.targetGroups.count() then return

    ' Animate old row to unfocused, new row to focused
    m.targetGroups[m.currentRowIndex].animateToTargetSet = m.unfocusedTargetSets[m.currentRowIndex]
    m.targetGroups[newIndex].animateToTargetSet = m.focusedTargetSets[newIndex]

    ' Scroll container
    currentY = m.baseContainerY - m.rowPositions[m.currentRowIndex]
    targetY = m.baseContainerY - m.rowPositions[newIndex]
    m.scrollInterp.keyValue = [[m.containerX, currentY], [m.containerX, targetY]]
    m.scrollAnim.control = "start"

    ' Move focus
    m.targetGroups[newIndex].setFocus(true)
    m.currentRowIndex = newIndex

    updateLabels()
end sub

sub updateLabels()
    rowDef = m.rowDefs[m.currentRowIndex]
    m.focusLabel.text = rowDef.title + " (" + (m.currentRowIndex + 1).toStr() + "/" + m.rowDefs.count().toStr() + ") | Item " + m.itemIndices[m.currentRowIndex].toStr()
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if key = "down"
        scrollToRow(m.currentRowIndex + 1)
        return true
    else if key = "up"
        scrollToRow(m.currentRowIndex - 1)
        return true
    else if key = "right"
        tg = m.targetGroups[m.currentRowIndex]
        rowDef = m.rowDefs[m.currentRowIndex]
        newItem = m.itemIndices[m.currentRowIndex] + 1
        if newItem < rowDef.itemCount
            m.itemIndices[m.currentRowIndex] = newItem
            tg.animateToItem = newItem
            updateLabels()
        end if
        return true
    else if key = "left"
        tg = m.targetGroups[m.currentRowIndex]
        newItem = m.itemIndices[m.currentRowIndex] - 1
        if newItem >= 0
            m.itemIndices[m.currentRowIndex] = newItem
            tg.animateToItem = newItem
            updateLabels()
        end if
        return true
    end if

    return false
end function
