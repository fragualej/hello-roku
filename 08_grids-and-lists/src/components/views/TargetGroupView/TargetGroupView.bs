sub init()
    m.targetList1 = m.top.findNode("targetList1")
    m.targetList2 = m.top.findNode("targetList2")
    m.targetList3 = m.top.findNode("targetList3")
    m.focusLabel = m.top.findNode("focusLabel")

    m.targetLists = [m.targetList1, m.targetList2, m.targetList3]
    m.currentRowIndex = 0

    ' Configuration - smaller items to fit 3 rows
    m.visibleCols = 9
    m.sizes = {
        focused: { w: 320, h: 180 },
        base:    { w: 101, h: 180 }
    }
    m.gapX = 15

    ' Create shared TargetSets
    m.focusedTargetSet = createFocusedTargetSet()
    m.unfocusedTargetSet = createUnfocusedTargetSet()

    ' Setup each row
    for i = 0 to m.targetLists.count() - 1
        setupTargetList(m.targetLists[i], i = 0)
        setupContent(m.targetLists[i], i * 15)
        m.targetLists[i].observeField("itemFocused", "onItemFocused")
    end for

    ' Forward focus
    m.top.observeField("focusedChild", "onFocusedChildChanged")
end sub

sub onFocusedChildChanged()
    if m.top.hasFocus()
        m.targetLists[m.currentRowIndex].setFocus(true)
    end if
end sub

function createFocusedTargetSet() as object
    targetSet = createObject("roSGNode", "TargetSet")

    rects = []
    focusW = m.sizes.focused.w
    focusH = m.sizes.focused.h
    baseW = m.sizes.base.w
    baseH = m.sizes.base.h

    ' Start position (focused item at left)
    startX = -350

    ' Position 0: Focused (16:9)
    rects.push({ x: startX, y: -focusH / 2, width: focusW, height: focusH })

    ' Positions 1+: Unfocused (9:16)
    x = startX + focusW + m.gapX
    for i = 1 to m.visibleCols - 1
        rects.push({ x: x, y: -baseH / 2, width: baseW, height: baseH })
        x = x + baseW + m.gapX
    end for

    targetSet.targetRects = rects
    targetSet.focusIndex = 0

    return targetSet
end function

function createUnfocusedTargetSet() as object
    targetSet = createObject("roSGNode", "TargetSet")

    rects = []
    baseW = m.sizes.base.w
    baseH = m.sizes.base.h

    startX = -250
    x = startX

    for i = 0 to m.visibleCols - 1
        rects.push({ x: x, y: -baseH / 2, width: baseW, height: baseH })
        x = x + baseW + m.gapX
    end for

    targetSet.targetRects = rects
    targetSet.focusIndex = 0

    return targetSet
end function

sub setupTargetList(targetList as object, isFocused as boolean)
    targetList.focusedTargetSet = m.focusedTargetSet
    targetList.unfocusedTargetSet = m.unfocusedTargetSet

    if isFocused
        targetList.targetSet = m.focusedTargetSet
    else
        targetList.targetSet = m.unfocusedTargetSet
    end if

    targetList.showTargetRects = false
    targetList.itemComponentName = "TargetGroupItem"
end sub

sub setupContent(targetList as object, startIndex as integer)
    contentRoot = createObject("roSGNode", "ContentNode")
    colors = Constants.Palette.GetItemColors()

    for i = 0 to 14
        child = contentRoot.createChild("ContentNode")
        child.title = (startIndex + i).toStr()
        child.addFields({ itemColor: colors[i mod colors.count()] })
    end for

    targetList.content = contentRoot
end sub

sub onItemFocused()
    for i = 0 to m.targetLists.count() - 1
        if m.targetLists[i].hasFocus()
            m.currentRowIndex = i
            m.focusLabel.text = "Row " + (i + 1).toStr() + " - Item " + m.targetLists[i].itemFocused.toStr()
            exit for
        end if
    end for
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if key = "down"
        newIndex = m.currentRowIndex + 1
        if newIndex < m.targetLists.count()
            m.targetLists[newIndex].setFocus(true)
            m.currentRowIndex = newIndex
            return true
        end if
    else if key = "up"
        newIndex = m.currentRowIndex - 1
        if newIndex >= 0
            m.targetLists[newIndex].setFocus(true)
            m.currentRowIndex = newIndex
            return true
        end if
    end if

    return false
end function
