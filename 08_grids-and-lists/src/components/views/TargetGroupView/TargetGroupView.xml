<?xml version="1.0" encoding="utf-8"?>
<component name="TargetGroupView" extends="BaseView">
    <script type="text/brighterscript" uri="TargetGroupView.bs" />

    <children>
        <Label
            id="titleLabel"
            text="TargetGroup (Multi-Type Rows)"
            translation="[50, 30]"
            font="font:MediumBoldSystemFont"
        />

        <Label
            id="descLabel"
            text="Programmatic rows with scroll - UP/DOWN to scroll, LEFT/RIGHT to navigate"
            translation="[50, 70]"
            font="font:SmallSystemFont"
            color="#888888"
            width="1400"
        />

        <Group
            id="scrollContainer"
            translation="[500, 400]" />

        <Animation id="scrollAnim" duration="0.3" easeFunction="inOutCubic">
            <Vector2DFieldInterpolator
                id="scrollInterp"
                fieldToInterp="scrollContainer.translation"
                key="[0.0, 1.0]"
            />
        </Animation>

        <Label
            id="focusLabel"
            translation="[50, 1000]"
            font="font:SmallSystemFont"
        />
    </children>
</component>