<?xml version="1.0" encoding="utf-8" ?>
<component name="TargetGroupView" extends="BaseView">
    <script type="text/brighterscript" uri="TargetGroupView.bs" />

    <children>
        <Label
            id="titleLabel"
            text="TargetGroup Example"
            translation="[50, 30]"
            font="font:MediumBoldSystemFont"
        />

        <Label
            id="descLabel"
            text="Multiple TargetLists with shared TargetSets - UP/DOWN to change rows"
            translation="[50, 70]"
            font="font:SmallSystemFont"
            color="#888888"
            width="1400"
        />

        <TargetList
            id="targetList1"
            translation="[700, 250]"
            advanceKey="right"
            reverseKey="left"
        />

        <TargetList
            id="targetList2"
            translation="[700, 480]"
            advanceKey="right"
            reverseKey="left"
        />

        <TargetList
            id="targetList3"
            translation="[700, 710]"
            advanceKey="right"
            reverseKey="left"
        />

        <Label
            id="row1Label"
            text="Row 1"
            translation="[50, 220]"
            font="font:SmallSystemFont"
            color="#888888"
        />

        <Label
            id="row2Label"
            text="Row 2"
            translation="[50, 450]"
            font="font:SmallSystemFont"
            color="#888888"
        />

        <Label
            id="row3Label"
            text="Row 3"
            translation="[50, 680]"
            font="font:SmallSystemFont"
            color="#888888"
        />

        <Label
            id="focusLabel"
            translation="[50, 920]"
            font="font:SmallSystemFont"
        />
    </children>
</component>
