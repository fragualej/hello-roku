<?xml version="1.0" encoding="utf-8" ?>
<component name="RowListView" extends="BaseView">
    <script type="text/brighterscript" uri="RowListView.bs" />

    <children>
        <Label
            id="titleLabel"
            text="RowList Example"
            translation="[50, 30]"
            font="font:MediumBoldSystemFont"
        />

        <Label
            id="descLabel"
            text="Multiple horizontal rows with vertical scrolling - Netflix-style"
            translation="[50, 70]"
            font="font:SmallSystemFont"
            color="#888888"
            width="1400"
        />

        <RowList
            id="rowList"
            translation="[50, 130]"
            itemComponentName="RowListItem"
            numRows="3"
            itemSize="[250, 220]"
            itemSpacing="[20, 20]"
            rowItemSize="[[250, 180], [200, 120], [300, 200], [180, 100], [220, 150]]"
            rowItemSpacing="[[15, 0], [10, 0], [20, 0], [8, 0], [12, 0]]"
            showRowLabel="[true]"
            rowLabelOffset="[[0, 10], [0, 10], [0, 10], [0, 10], [0, 10]]"
        />

        <Label
            id="focusLabel"
            translation="[50, 900]"
            font="font:SmallSystemFont"
        />
    </children>
</component>
