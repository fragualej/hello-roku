<?xml version="1.0" encoding="utf-8" ?>
<component name="RowListView" extends="BaseView">
    <script type="text/brighterscript" uri="RowListView.bs" />

    <children>
        <Label
            id="titleLabel"
            text="RowList Example"
            translation="[50, 30]"
            font="font:MediumBoldSystemFont"
        />

        <Label
            id="descLabel"
            text="Multiple rows with different heights per row"
            translation="[50, 70]"
            font="font:SmallSystemFont"
            color="#888888"
            width="1400"
        />

        <RowList
            id="rowList"
            translation="[50, 130]"
            itemComponentName="RowListItem"
            numRows="3"
            itemSize="[1400, 200]"
            itemSpacing="[20, 20]"
            rowItemSize="[[280, 160], [200, 120], [320, 180], [240, 140], [260, 150]]"
            rowItemSpacing="[[15, 0], [12, 0], [18, 0], [10, 0], [14, 0]]"
            showRowLabel="[true]"
            rowLabelOffset="[[0, 10], [0, 10], [0, 10], [0, 10], [0, 10]]"
        />

        <Label
            id="focusLabel"
            translation="[50, 900]"
            font="font:SmallSystemFont"
        />
    </children>
</component>
