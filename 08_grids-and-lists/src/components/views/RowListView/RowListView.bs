sub init()
    m.rowList = m.top.findNode("rowList")
    m.focusLabel = m.top.findNode("focusLabel")

    setupContent()

    m.rowList.observeField("rowItemFocused", "onItemFocused")

    ' Forward focus to rowList when this view gets focus
    m.top.observeField("focusedChild", "onFocusedChildChanged")
end sub

sub onFocusedChildChanged()
    if m.top.hasFocus()
        m.rowList.setFocus(true)
    end if
end sub

sub setupContent()
    contentRoot = createObject("roSGNode", "ContentNode")
    colors = Constants.Palette.GetItemColors()

    ' Create 5 rows
    for rowIndex = 0 to 4
        rowNode = contentRoot.createChild("ContentNode")
        rowNode.title = "Row " + rowIndex.toStr()

        ' Create 25 items per row
        for itemIndex = 0 to 24
            itemNode = rowNode.createChild("ContentNode")
            itemNode.title = "R" + rowIndex.toStr() + " C" + itemIndex.toStr()
            colorIndex = (rowIndex + itemIndex) mod colors.count()
            itemNode.addFields({ itemColor: colors[colorIndex] })
        end for
    end for

    m.rowList.content = contentRoot
end sub

sub onItemFocused()
    focused = m.rowList.rowItemFocused
    if focused <> invalid and focused.count() = 2
        rowIndex = focused[0]
        itemIndex = focused[1]
        m.focusLabel.text = "Row " + rowIndex.toStr() + " / Item " + itemIndex.toStr()
    end if
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    return false
end function
