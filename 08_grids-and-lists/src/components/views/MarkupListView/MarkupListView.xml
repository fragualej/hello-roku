<?xml version="1.0" encoding="utf-8" ?>
<component name="MarkupListView" extends="BaseView">
    <script type="text/brighterscript" uri="MarkupListView.bs" />

    <children>
        <Label
            id="titleLabel"
            text="MarkupList Example"
            translation="[50, 30]"
            font="font:MediumBoldSystemFont"
        />

        <Label
            id="descLabel"
            text="Vertical list with custom item rendering - Built-in navigation"
            translation="[50, 70]"
            font="font:SmallSystemFont"
            color="#888888"
            width="1400"
        />

        <MarkupList
            id="markupList"
            translation="[50, 130]"
            itemComponentName="MarkupListItem"
            itemSize="[600, 80]"
            itemSpacing="[0, 10]"
        />

        <Label
            id="focusLabel"
            translation="[50, 900]"
            font="font:SmallSystemFont"
        />
    </children>
</component>
