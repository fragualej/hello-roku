<?xml version="1.0" encoding="utf-8" ?>
<component name="TargetGroupDemoItem" extends="Group">
    <interface>
        <field id="index" type="int" />
        <field id="groupHasFocus" type="boolean" onChange="onFocusPercentChanged" />
        <field id="itemContent" type="node" onChange="onContentChanged" />
        <field id="currTarget" type="float" onChange="onCurrTargetChanged" />
        <field id="currRect" type="rect2d" onChange="onCurrRectChanged" />
        <field id="focusPercent" type="float" onChange="onFocusPercentChanged" />
    </interface>

    <script type="text/brighterscript" uri="pkg:/source/core/Constants.bs" />
    <script type="text/brighterscript" uri="TargetGroupDemoItem.bs" />

    <children>
        <Rectangle id="itemRect" width="100" height="128">
            <Label
                id="itemLabel"
                translation="[10, 10]"
                font="font:SmallBoldSystemFont"
            />
        </Rectangle>
        <ColorFieldInterpolator
            id="focusColorInterp"
            key="[0.0, 1.0]"
        />
    </children>
</component>
