sub init()
    m.itemRect = m.top.findNode("itemRect")
    m.itemLabel = m.top.findNode("itemLabel")

    m.baseColor = Constants.Colors.Secondary
    m.focusColor = Constants.Colors.Primary
end sub

sub onContentChanged()
    content = m.top.itemContent
    if content <> invalid
        m.itemLabel.text = content.title

        if content.hasField("itemColor") and content.itemColor <> invalid
            m.baseColor = content.itemColor
        end if

        updateVisuals()
    end if
end sub

sub onSizeChanged()
    updateVisuals()
end sub

sub onFocusChanged()
    updateVisuals()
end sub

sub updateVisuals()
    width = m.top.width
    height = m.top.height

    if width > 0 and height > 0
        m.itemRect.width = width
        m.itemRect.height = height
        m.itemLabel.width = width
        m.itemLabel.height = height
    end if

    ' Update color based on focus
    itemHasFocus = m.top.itemHasFocus
    rowHasFocus = m.top.rowHasFocus
    focusPercent = m.top.focusPercent

    if itemHasFocus and rowHasFocus
        m.itemRect.color = m.focusColor
    else if rowHasFocus and focusPercent > 0.5
        m.itemRect.color = m.focusColor
    else
        m.itemRect.color = m.baseColor
    end if
end sub
