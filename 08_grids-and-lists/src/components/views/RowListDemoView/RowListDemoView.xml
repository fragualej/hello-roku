<?xml version="1.0" encoding="utf-8"?>
<component name="RowListDemoView" extends="BaseView">
    <script type="text/brighterscript" uri="RowListDemoView.bs" />

    <children>
        <Label
            id="titleLabel"
            text="RowList Demo (3 Item Types)"
            translation="[50, 30]"
            font="font:MediumBoldSystemFont"
        />

        <Label
            id="descLabel"
            text="Live, Top 10, Originals - items interpolate between focused/unfocused sizes"
            translation="[50, 70]"
            font="font:SmallSystemFont"
            color="#888888"
            width="1400"
        />

        <RowList
            id="rowList"
            translation="[50, 150]"
            itemComponentName="RowListDemoItem"
            showRowLabel="[false]"
            rowLabelOffset="[[0, 0]]"
            drawFocusFeedback="false"
            vertFocusAnimationStyle="fixedFocus"
            rowFocusAnimationStyle="fixedFocus"
        />

        <Label
            id="focusLabel"
            translation="[50, 900]"
            font="font:SmallSystemFont"
        />
    </children>
</component>