<?xml version="1.0" encoding="utf-8" ?>
<component name="TargetListView" extends="BaseView">
    <script type="text/brighterscript" uri="TargetListView.bs" />

    <children>
        <Label
            id="titleLabel"
            text="TargetList Example"
            translation="[50, 30]"
            font="font:MediumBoldSystemFont"
        />

        <Label
            id="descLabel"
            text="Horizontal list with custom focus sizing (16:9 focused, 9:16 unfocused)"
            translation="[50, 70]"
            font="font:SmallSystemFont"
            color="#888888"
            width="1400"
        />

        <TargetList
            id="targetList"
            translation="[750, 450]"
            advanceKey="right"
            reverseKey="left"
        />

        <Label
            id="focusLabel"
            translation="[50, 900]"
            font="font:SmallSystemFont"
        />
    </children>
</component>
